# 复制为 frontend/.env.development 或 frontend/.env.production（勿提交含密钥的文件）
#
# 开发推荐走 Vite 代理（单端口 8088）：与当前页同源，避免跨域
# VITE_AWARD_LOG_BASE_URL=http://localhost:3000/award-log
#
# 生产 Nginx 同域：
# VITE_AWARD_LOG_BASE_URL=https://your.domain.example/award-log
#
# 普通 API 超时（毫秒）
# VITE_API_TIMEOUT_MS=600000
#
# Vite dev 代理目标（一律 8088，不再使用 8089）
# VITE_DEV_PROXY_TARGET=http://127.0.0.1:8088
#
# 可选：完整 WebSocket URL；不设则顶栏 WS 使用当前页 host + /award-log/ws/performance
# VITE_AWARD_LOG_WS_URL=wss://api.example.com/award-log/ws/performance
