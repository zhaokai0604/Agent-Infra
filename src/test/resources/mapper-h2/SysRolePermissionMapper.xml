<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.award.log.mapper.SysRolePermissionMapper">
    <!-- 根据角色ID查询角色权限关联列表 -->
    <select id="selectByRoleId" parameterType="java.lang.Integer" resultType="com.award.log.model.SysRolePermission">
        SELECT * FROM sys_role_permission WHERE role_id = #{roleId}
    </select>

    <!-- 根据权限ID查询角色权限关联列表 -->
    <select id="selectByPermissionId" parameterType="java.lang.Integer" resultType="com.award.log.model.SysRolePermission">
        SELECT * FROM sys_role_permission WHERE permission_id = #{permissionId}
    </select>

    <!-- 插入角色权限关联（表仅有 role_id, permission_id） -->
    <insert id="insert" parameterType="com.award.log.model.SysRolePermission">
        INSERT INTO sys_role_permission (role_id, permission_id)
        VALUES (#{roleId}, #{permissionId})
    </insert>

    <!-- 批量插入角色权限关联 -->
    <insert id="batchInsert" parameterType="java.util.List">
        INSERT INTO sys_role_permission (role_id, permission_id)
        VALUES
        <foreach collection="rolePermissions" item="item" separator=",">
            (#{item.roleId}, #{item.permissionId})
        </foreach>
    </insert>

    <!-- 删除角色权限关联 -->
    <delete id="deleteByRoleIdAndPermissionId" parameterType="java.util.Map">
        DELETE FROM sys_role_permission WHERE role_id = #{roleId} AND permission_id = #{permissionId}
    </delete>

    <!-- 根据角色ID删除角色权限关联 -->
    <delete id="deleteByRoleId" parameterType="java.lang.Integer">
        DELETE FROM sys_role_permission WHERE role_id = #{roleId}
    </delete>

    <!-- 根据权限ID删除角色权限关联 -->
    <delete id="deleteByPermissionId" parameterType="java.lang.Integer">
        DELETE FROM sys_role_permission WHERE permission_id = #{permissionId}
    </delete>
</mapper>