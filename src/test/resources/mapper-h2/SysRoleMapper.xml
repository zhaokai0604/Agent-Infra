<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.award.log.mapper.SysRoleMapper">
    <!-- 根据角色ID查询角色 -->
    <select id="selectById" parameterType="java.lang.Integer" resultType="com.award.log.model.SysRole">
        SELECT * FROM sys_role WHERE role_id = #{roleId}
    </select>

    <!-- 根据角色名称查询角色 -->
    <select id="selectByRoleName" parameterType="java.lang.String" resultType="com.award.log.model.SysRole">
        SELECT * FROM sys_role WHERE role_name = #{roleName}
    </select>

    <!-- 查询所有角色 -->
    <select id="selectAll" resultType="com.award.log.model.SysRole">
        SELECT * FROM sys_role
    </select>

    <!-- 分页查询角色列表 -->
    <select id="selectPage" resultType="com.award.log.model.SysRole">
        SELECT * FROM sys_role LIMIT #{offset}, #{limit}
    </select>

    <!-- 查询角色总数 -->
    <select id="countAll" resultType="java.lang.Long">
        SELECT COUNT(*) FROM sys_role
    </select>

    <!-- 插入角色（列以 schema.sql 为准：role_desc，无 update_time） -->
    <insert id="insert" parameterType="com.award.log.model.SysRole" useGeneratedKeys="true" keyProperty="roleId">
        INSERT INTO sys_role (role_name, role_desc, create_time)
        VALUES (#{roleName}, #{roleDesc}, NOW())
    </insert>

    <!-- 更新角色信息 -->
    <update id="updateById" parameterType="com.award.log.model.SysRole">
        UPDATE sys_role
        SET
            role_name = #{roleName},
            role_desc = #{roleDesc}
        WHERE role_id = #{roleId}
    </update>

    <!-- 删除角色 -->
    <delete id="deleteById" parameterType="java.lang.Integer">
        DELETE FROM sys_role WHERE role_id = #{roleId}
    </delete>
</mapper>