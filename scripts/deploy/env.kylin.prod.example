# 麒麟 V11 + LoongArch64 生产环境变量示例
# 复制为 /etc/threshcore/threshcore.env 并由 systemd 加载（勿提交含真实密钥的文件）

SPRING_PROFILES_ACTIVE=prod-kylin

# ---------- 数据库 MySQL 8（MariaDB 可改 DB_DRIVER/DB_URL）----------
DB_DRIVER=com.mysql.cj.jdbc.Driver
DB_URL=jdbc:mysql://127.0.0.1:3306/log_analysis?useUnicode=true&characterEncoding=utf-8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=CHANGE_ME

# ---------- DeepSeek ----------
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=CHANGE_ME
AI_CHAT_MODEL=deepseek-chat
AI_CHAT_TEMPERATURE=0.1
AI_CHAT_TOP_P=0.85
AI_EMBEDDING_MODEL=deepseek-chat

# ---------- 应用 / 安全 ----------
APP_MANAGEMENT_ENABLED=false
APP_AI_AUDIT_RELAXED_READ=false
APP_CONFIG_SECRET=CHANGE_ME
# 浏览器/Nginx 正式入口的 Origin 白名单；多个来源用英文逗号分隔，不要使用 * 放开公网。
APP_CORS_ALLOWED_ORIGIN_PATTERNS=https://threshcore.example.com

# ---------- Agent / MCP / AWM（生产默认全开）----------
AGENT_RUN_AS_USER=award-agent
# 麒麟实机验收若要“确认后真删”/清理 root 拥有的 /var/log、/var/cache 文件，保持 false
AGENT_MIN_PRIVILEGE=true
AGENT_RUNTIME_ENABLED=true
AGENT_AUTONOMOUS_ENABLED=true
AGENT_AWM_ENABLED=true
AGENT_AWM_SEED=true
AGENT_AWM_FAILURE_INSIGHT=true
AGENT_MCP_HTTP_ALLOW_ALL=false

# ---------- 运维：巡检 + 自动修复（真实执行，非 dry-run）----------
OPS_DRY_RUN_GLOBAL=false
OPS_AUTO_REMEDIATION_ENABLED=true
OPS_AUTO_REMEDIATION_MODE=HYBRID
OPS_PATROL_ENABLED=true
OPS_PATROL_INSPECT_ROOTS=/var/log,/tmp,/var/tmp,/var/cache,/opt/threshcore/logs
OPS_GOVERNANCE_ENABLED=true

# ---------- 日志采集 / 分析（麒麟路径）----------
LOG_COLLECTOR_ROOT=/var/log
LOG_COLLECTOR_MAX_DEPTH=4
RF_FORCE_HEURISTIC_LOONGARCH=true
LOG_ANALYSIS_MAX_CONCURRENT=4

# ---------- 知识库 Qdrant ----------
# 本机 Docker：http://127.0.0.1:6333（一般无需 Key）
# Cloud：https://xxxx.region.aws.cloud.qdrant.io + QDRANT_API_KEY
KNOWLEDGE_ENABLED=true
KNOWLEDGE_SEED_ON_STARTUP=true
KNOWLEDGE_LOCAL_EMBED_FALLBACK=true
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=ops_knowledge

# ---------- 可选中间件（赛题默认关闭）----------
AWARD_MIDDLEWARE_KAFKA=false
AWARD_MIDDLEWARE_REDIS=false
ELASTIC_ENABLED=false
MANAGEMENT_HEALTH_REDIS_ENABLED=false
MANAGEMENT_HEALTH_ELASTICSEARCH_ENABLED=false

# ---------- HTTP 超时（与 application-kylin 一致）----------
SERVER_TOMCAT_CONNECTION_TIMEOUT_MS=300000
