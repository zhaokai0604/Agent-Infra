# 本地复制为 .env 后按需填写；勿将含真实密钥的 .env 提交 Git（.env 已在 .gitignore）
#
# PowerShell:  $env:DB_PASSWORD="..."; $env:AI_API_KEY="..."
# Bash:        export DB_PASSWORD=... AI_API_KEY=...
#
# 说明：application.yml 中 **不设** DB_PASSWORD / AI_API_KEY 的仓库默认值；
# 开发请配合 application-local.yml（见 application-local.example.yml）或本文件导出变量。

DB_URL=jdbc:mysql://localhost:3306/log_analysis?useUnicode=true&characterEncoding=utf-8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
DB_DRIVER=com.mysql.cj.jdbc.Driver
DB_USERNAME=root
DB_PASSWORD=

AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_CHAT_MODEL=deepseek-chat
AI_STREAM_USAGE=true
# DEFAULT keeps the current Spring AI model; AUTO selects a configured profile.
AI_ROUTING_MODE=DEFAULT
AI_DEFAULT_PROFILE=default
AI_CONTEXT_WINDOW=32768
AI_AUTO_PROFILES=fast,quality
# Optional OpenAI-compatible profiles used by AUTO. Keep keys out of Git.
AI_FAST_ENABLED=false
AI_FAST_BASE_URL=
AI_FAST_API_KEY=
AI_FAST_MODEL=
AI_QUALITY_ENABLED=false
AI_QUALITY_BASE_URL=
AI_QUALITY_API_KEY=
AI_QUALITY_MODEL=

# 知识库向量库
# 本机 Docker：docker compose up -d qdrant 后使用下面两行（无需 API Key）
# QDRANT_URL=http://localhost:6333
# QDRANT_COLLECTION=ops_knowledge
#
# Qdrant Cloud：控制台复制 Cluster URL 与 API Key（勿提交 Git）
# QDRANT_URL=https://你的集群ID.region.gcp.cloud.qdrant.io
# QDRANT_API_KEY=你的API密钥
# QDRANT_COLLECTION=ops_knowledge

# ---------- 日志分析告警推送（后端 SMTP / 企业微信，与控制台「告警配置」里的收件人配合使用）----------
# 邮件：QQ 邮箱示例 — 在邮箱设置中开启 SMTP，password 填「授权码」而非登录密码
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_PROTOCOL=smtp
MAIL_STARTTLS_ENABLE=false

# 企业微信（仅当控制台勾选「企业微信」并填写用户 ID 时需要）
WECHAT_CORP_ID=
WECHAT_APP_SECRET=
WECHAT_AGENT_ID=1000002

# Docker Compose MySQL 根密码（与 DB_PASSWORD 可一致）
# MYSQL_ROOT_PASSWORD=
# MYSQL_DATABASE=log_analysis

# 可选：文件日志采集器监视目录
# LOG_COLLECTOR_ROOT=auto

# 可选：最小权限执行所用 OS 用户（生产见 README sudoers 说明）
# AGENT_RUN_AS_USER=award-agent
